# Job Hunter OS - Environment Configuration
# Paths are set automatically. Only fill in what you need.

# Database (auto-resolved to user data directory)
# DATABASE_URL=sqlite:///./job_hunter.db

# Secret key — if empty, a random one is generated at startup
# SECRET_KEY=

# App environment
APP_ENV=production

# CORS origins for dev mode (Electron handles production)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload directory (auto-resolved to user data directory)
# UPLOAD_DIR=./uploads

# Job source API keys (optional — most sources work without keys)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
USAJOBS_API_KEY=
REMOTIVE_API_KEY=

# AI provider (optional — app works fully without AI)
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# n8n workflow automation (optional)
N8N_URL=http://localhost:5678
N8N_USER=
N8N_PASSWORD=

# Email notifications (optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_SSL=true

# Webhook secret for external integrations
WEBHOOK_SECRET=

# Contact email for job board user agents
USER_AGENT=JobHunterOS/1.0 (contact@example.com)
