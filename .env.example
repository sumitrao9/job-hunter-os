# Job Hunter OS environment variables
DATABASE_URL=sqlite:///./data/job_hunter.db
SECRET_KEY=change-me
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
N8N_URL=http://localhost:5678
N8N_USER=
N8N_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_SSL=true
WEBHOOK_SECRET=

# Job Discovery APIs (all optional — app works without them)
# Adzuna: https://developer.adzuna.com/ (free tier 250 req/day, register for keys)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch (RapidAPI): https://rapidapi.com/jsearch-api-api/ (free tier 50 req/month)
JSEARCH_API_KEY=

# USAJOBS (US federal jobs): https://www.usajobs.gov/developers/ (optional)
USAJOBS_API_KEY=

# Remotive (optional premium API key)
REMOTIVE_API_KEY=
USER_AGENT=JobHunterOS/1.0 (contact@example.com)
